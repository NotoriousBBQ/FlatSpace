{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/docs/session_configuration.md\""
          },
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/commands/read-latest-handoff.md\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-on-exit.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
